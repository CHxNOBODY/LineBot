# --- LINE Messaging API ---
# LINE Developers Console > your channel > Basic settings > Channel secret
LINE_CHANNEL_SECRET=your_channel_secret_here
# LINE Developers Console > your channel > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# --- Server ---
PORT=3000
# Timezone used for dates shown on bill cards
TZ=Asia/Bangkok
# Currency suffix shown in the UI
CURRENCY=บาท

# --- Database ---
DATABASE_URL="file:./dev.db"
